{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["core/**/*.ts", "dom/**/*.ts", "vue/**/*.ts", "web/**/*.ts", "web/**/*.vue", "tests/**/*.ts", "vite.config.ts"]
}
