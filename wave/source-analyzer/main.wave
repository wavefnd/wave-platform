// Display lexer for the pinned Wave v0.2.1-pre-beta compiler.
// Keep keyword/type lists and token boundaries in sync with frontend/src/services/waveSyntax.ts.
fun is_identifier_byte(value: u8) -> bool {
    if ((value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')) {
        return true;
    }
    if ((value >= '0' && value <= '9') || value == '_' || value >= 128) {
        return true;
    }
    return false;
}

fun string_length(value: str) -> i64 {
    var data: ptr<u8> = value;
    var length: i64 = 0;
    while (data[length] != 0) {
        length += 1;
    }
    return length;
}

fun matches_word(source: ptr<u8>, source_length: i64, offset: i64, word: str) -> bool {
    var word_length: i64 = string_length(word);
    if (offset + word_length > source_length) {
        return false;
    }
    if (offset > 0) {
        var previous_offset: i64 = offset - 1;
        if (is_identifier_byte(source[previous_offset])) {
            return false;
        }
    }

    var word_data: ptr<u8> = word;
    var index: i64 = 0;
    while (index < word_length) {
        var source_index: i64 = offset + index;
        if (source[source_index] != word_data[index]) {
            return false;
        }
        index += 1;
    }

    var end_offset: i64 = offset + word_length;
    if (end_offset < source_length && is_identifier_byte(source[end_offset])) {
        return false;
    }
    return true;
}

fun keyword_length(source: ptr<u8>, source_length: i64, offset: i64) -> i64 {
    if (matches_word(source, source_length, offset, "async")) { return 5; }
    if (matches_word(source, source_length, offset, "await")) { return 5; }
    if (matches_word(source, source_length, offset, "fun")) { return 3; }
    if (matches_word(source, source_length, offset, "extern")) { return 6; }
    if (matches_word(source, source_length, offset, "export")) { return 6; }
    if (matches_word(source, source_length, offset, "pub")) { return 3; }
    if (matches_word(source, source_length, offset, "type")) { return 4; }
    if (matches_word(source, source_length, offset, "enum")) { return 4; }
    if (matches_word(source, source_length, offset, "variant")) { return 7; }
    if (matches_word(source, source_length, offset, "static")) { return 6; }
    if (matches_word(source, source_length, offset, "var")) { return 3; }
    if (matches_word(source, source_length, offset, "deref")) { return 5; }
    if (matches_word(source, source_length, offset, "let")) { return 3; }
    if (matches_word(source, source_length, offset, "mut")) { return 3; }
    if (matches_word(source, source_length, offset, "const")) { return 5; }
    if (matches_word(source, source_length, offset, "if")) { return 2; }
    if (matches_word(source, source_length, offset, "else")) { return 4; }
    if (matches_word(source, source_length, offset, "proto")) { return 5; }
    if (matches_word(source, source_length, offset, "struct")) { return 6; }
    if (matches_word(source, source_length, offset, "while")) { return 5; }
    if (matches_word(source, source_length, offset, "for")) { return 3; }
    if (matches_word(source, source_length, offset, "module")) { return 6; }
    if (matches_word(source, source_length, offset, "class")) { return 5; }
    if (matches_word(source, source_length, offset, "in")) { return 2; }
    if (matches_word(source, source_length, offset, "out")) { return 3; }
    if (matches_word(source, source_length, offset, "clobber")) { return 7; }
    if (matches_word(source, source_length, offset, "is")) { return 2; }
    if (matches_word(source, source_length, offset, "as")) { return 2; }
    if (matches_word(source, source_length, offset, "asm")) { return 3; }
    if (matches_word(source, source_length, offset, "xnand")) { return 5; }
    if (matches_word(source, source_length, offset, "import")) { return 6; }
    if (matches_word(source, source_length, offset, "return")) { return 6; }
    if (matches_word(source, source_length, offset, "continue")) { return 8; }
    if (matches_word(source, source_length, offset, "print")) { return 5; }
    if (matches_word(source, source_length, offset, "input")) { return 5; }
    if (matches_word(source, source_length, offset, "println")) { return 7; }
    if (matches_word(source, source_length, offset, "match")) { return 5; }
    if (matches_word(source, source_length, offset, "break")) { return 5; }
    if (matches_word(source, source_length, offset, "true")) { return 4; }
    if (matches_word(source, source_length, offset, "false")) { return 5; }
    if (matches_word(source, source_length, offset, "null")) { return 4; }
    return 0;
}

fun type_length(source: ptr<u8>, source_length: i64, offset: i64) -> i64 {
    if (matches_word(source, source_length, offset, "void")) { return 4; }
    if (matches_word(source, source_length, offset, "array")) { return 5; }
    if (matches_word(source, source_length, offset, "bool")) { return 4; }
    if (matches_word(source, source_length, offset, "byte")) { return 4; }
    if (matches_word(source, source_length, offset, "char")) { return 4; }
    if (matches_word(source, source_length, offset, "f32")) { return 3; }
    if (matches_word(source, source_length, offset, "f64")) { return 3; }
    if (matches_word(source, source_length, offset, "isz")) { return 3; }
    if (matches_word(source, source_length, offset, "usz")) { return 3; }
    if (matches_word(source, source_length, offset, "ptr")) { return 3; }
    if (matches_word(source, source_length, offset, "str")) { return 3; }
    if (matches_word(source, source_length, offset, "i8")) { return 2; }
    if (matches_word(source, source_length, offset, "i16")) { return 3; }
    if (matches_word(source, source_length, offset, "i32")) { return 3; }
    if (matches_word(source, source_length, offset, "i64")) { return 3; }
    if (matches_word(source, source_length, offset, "i128")) { return 4; }
    if (matches_word(source, source_length, offset, "i256")) { return 4; }
    if (matches_word(source, source_length, offset, "i512")) { return 4; }
    if (matches_word(source, source_length, offset, "i1024")) { return 5; }
    if (matches_word(source, source_length, offset, "u8")) { return 2; }
    if (matches_word(source, source_length, offset, "u16")) { return 3; }
    if (matches_word(source, source_length, offset, "u32")) { return 3; }
    if (matches_word(source, source_length, offset, "u64")) { return 3; }
    if (matches_word(source, source_length, offset, "u128")) { return 4; }
    if (matches_word(source, source_length, offset, "u256")) { return 4; }
    if (matches_word(source, source_length, offset, "u512")) { return 4; }
    if (matches_word(source, source_length, offset, "u1024")) { return 5; }
    return 0;
}

fun mark_range(kinds: ptr<u8>, start: i64, end: i64, kind: u8) {
    var index: i64 = start;
    while (index < end) {
        deref kinds[index] = kind;
        index += 1;
    }
}

fun quoted_end(source: ptr<u8>, source_length: i64, offset: i64, quote: u8) -> i64 {
    var index: i64 = offset + 1;
    while (index < source_length) {
        if (source[index] == '\n' || source[index] == '\r') {
            return index;
        } else if (source[index] == '\\') {
            index += 1;
            if (index < source_length && source[index] != '\n' && source[index] != '\r') { index += 1; }
        } else if (source[index] == quote) {
            return index + 1;
        } else {
            index += 1;
        }
    }
    return source_length;
}

export(c, "wave_source_analyzer_abi_version") fun source_analyzer_abi_version() -> i32 {
    return 2;
}

export(c, "wave_source_analyzer_highlight") fun source_analyzer_highlight(
    source: ptr<u8>,
    source_length: i64,
    out_kinds: ptr<u8>,
    out_length: i64
) -> i32 {
    if (source_length < 0 || out_length < source_length) {
        return -1;
    }

    var clear_index: i64 = 0;
    while (clear_index < source_length) {
        deref out_kinds[clear_index] = 0;
        clear_index += 1;
    }

    var index: i64 = 0;
    while (index < source_length) {
        var current: u8 = source[index];

        if (current == '"' || current == '\'') {
            var end: i64 = quoted_end(source, source_length, index, current);
            mark_range(out_kinds, index, end, 3);
            index = end;
        } else if (current == '/' && index + 1 < source_length) {
            var next_index: i64 = index + 1;
            if (source[next_index] == '/') {
                var start: i64 = index;
                index += 2;
                while (index < source_length && source[index] != '\n' && source[index] != '\r') {
                    index += 1;
                }
                mark_range(out_kinds, start, index, 4);
            } else if (source[next_index] == '*') {
                var start: i64 = index;
                index += 2;
                var depth: i64 = 1;
                while (index < source_length && depth > 0) {
                    var comment_next: i64 = index + 1;
                    if (comment_next < source_length && source[index] == '/' && source[comment_next] == '*') {
                        depth += 1;
                        index += 2;
                    } else if (comment_next < source_length && source[index] == '*' && source[comment_next] == '/') {
                        depth -= 1;
                        index += 2;
                    } else {
                        index += 1;
                    }
                }
                mark_range(out_kinds, start, index, 4);
            } else {
                index += 1;
            }
        } else if (current >= '0' && current <= '9') {
            var start: i64 = index;
            var prefix_offset: i64 = index + 1;
            var radix: bool = false;
            if (current == '0' && prefix_offset < source_length) {
                var prefix: u8 = source[prefix_offset];
                radix = prefix == 'x' || prefix == 'X' || prefix == 'o' || prefix == 'O' || prefix == 'b' || prefix == 'B';
            }
            index += 1;
            while (index < source_length) {
                var digit: u8 = source[index];
                var previous: i64 = index - 1;
                var next: i64 = index + 1;
                if (digit < 128 && is_identifier_byte(digit)) {
                    index += 1;
                } else if (!radix && digit == '.' && source[previous] != '.' && (next >= source_length || source[next] != '.')) {
                    index += 1;
                } else if (!radix && (digit == '+' || digit == '-') && (source[previous] == 'e' || source[previous] == 'E')) {
                    index += 1;
                } else {
                    break;
                }
            }
            mark_range(out_kinds, start, index, 5);
        } else {
            var keyword: i64 = keyword_length(source, source_length, index);
            if (keyword > 0) {
                var end: i64 = index + keyword;
                mark_range(out_kinds, index, end, 1);
                index = end;
            } else {
                var type_name: i64 = type_length(source, source_length, index);
                if (type_name > 0) {
                    var end: i64 = index + type_name;
                    mark_range(out_kinds, index, end, 2);
                    index = end;
                } else {
                    index += 1;
                    if (is_identifier_byte(current)) {
                        while (index < source_length && is_identifier_byte(source[index])) { index += 1; }
                    }
                }
            }
        }
    }
    return 0;
}
