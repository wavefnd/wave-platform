# Public web domain and the domain used for Wave email addresses.
WAVE_DOMAIN=wave-lang.dev
# Use the public domain here for automatic HTTPS in production.
WAVE_SITE_ADDRESS=http://localhost
WAVE_PUBLIC_URL=http://localhost:8080
WAVE_HTTP_PORT=8080
WAVE_HTTPS_PORT=8443

WAVE_REGISTRATION_OPEN=true
WAVE_SESSION_HOURS=720
WAVE_SECURE_COOKIES=false

# Generate both secrets before the first start. Remove WAVE_ADMIN_TOTP_SECRET
# after the owner has been created and the recovery email has been verified.
WAVE_AUTH_ENCRYPTION_KEY=
WAVE_TOTP_ISSUER=Wave Platform
WAVE_ADMIN_DISPLAY_NAME=
WAVE_ADMIN_USERNAME=
WAVE_ADMIN_RECOVERY_EMAIL=
WAVE_ADMIN_TOTP_SECRET=

# Optional Cloudflare Turnstile. When unset, no Cloudflare challenge is loaded.
WAVE_TURNSTILE_SITE_KEY=
WAVE_TURNSTILE_SECRET_KEY=

# SMTP ingress accepts server-to-server delivery for Wave addresses. Users send
# and read mail through Wave Mail; external mail clients are not supported.
WAVE_SMTP_HOSTNAME=mail.wave-lang.dev
WAVE_SMTP_HOST_PORT=2525
WAVE_SMTP_MAX_MESSAGE_BYTES=26214400
WAVE_SMTP_TLS_CERTIFICATE=
WAVE_SMTP_TLS_KEY=

# Use a relay when one is available. Without one, direct MX delivery is used.
WAVE_SMTP_RELAY_ADDRESS=
WAVE_SMTP_RELAY_USERNAME=
WAVE_SMTP_RELAY_PASSWORD=
WAVE_SMTP_RELAY_IMPLICIT_TLS=false
WAVE_SMTP_DIRECT_DELIVERY=true

# Enable only after publishing <selector>._domainkey.<domain> TXT in DNS.
WAVE_DKIM_DOMAIN=
WAVE_DKIM_SELECTOR=
WAVE_DKIM_PRIVATE_KEY=
